# Exemplo de arquivo de configuração (.env)
# Copie este arquivo como '.env' no novo notebook e preencha os valores

# --- SEGURANÇA ---
SECRET_KEY="crie_uma_chave_aleatoria_aqui"
MODO_DEBUG=False

# --- BANCO DE DADOS (DOCKER) ---
# Se usar Docker, o host deve ser 'db'
DATABASE_URL="postgresql://magabip_user:magabip_password@db:5432/magabip_db"

# --- LOGIN CORPORATIVO (OPCIONAL) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# IA GEMINI (Para diagnósticos)
GEMINI_API_KEY=""

# --- WEBHOOKS GOOGLE CHAT ---
GCHAT_WEBHOOK_URL_TI=""
GCHAT_WEBHOOK_URL_LIDERANCA=""

# --- VPN (OPCIONAL) ---
ENFORCE_VPN=false
VPN_IP_PREFIXES="10., 127.0.0.1, 192.168."
